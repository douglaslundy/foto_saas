FROM node:22-alpine
# Install fonts so sharp can render SVG text (without this, text appears as rectangles)
RUN apk add --no-cache fontconfig ttf-dejavu && fc-cache -f
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src/ ./src/
COPY workers/ ./workers/
CMD ["npx", "tsx", "workers/watermark.ts"]
